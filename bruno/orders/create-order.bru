meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "laboratoryId": "a0000000-0000-4000-a000-000000000003",
    "patientName": "Test Paciente",
    "priority": "normal",
    "notes": "Notas de la orden",
    "dueDate": "2026-02-01",
    "items": [
      {
        "workType": "CROWN",
        "teethNumbers": [11],
        "shade": "A2",
        "material": "ZIRCONIA",
        "quantity": 1,
        "description": "Corona superior"
      }
    ]
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("orderId", res.body.id);
  }
}
