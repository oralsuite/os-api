# ===========================================
# OralSuite - Variables de Entorno
# ===========================================
# Copia este archivo como .env:
#   cp .env.example .env
#
# Para desarrollo local, los valores por defecto funcionan con Docker Compose

# ===========================================
# Entorno
# ===========================================
NODE_ENV=development

# ===========================================
# Backend API (NestJS)
# ===========================================
PORT=3000
API_PREFIX=api

# ===========================================
# Base de Datos (PostgreSQL)
# ===========================================
# Estos valores coinciden con docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=oralsuite
DB_PASSWORD=oralsuite123
DB_NAME=oralsuite

# Conexión completa (alternativa)
# DATABASE_URL=postgresql://oralsuite:oralsuite123@localhost:5432/oralsuite

# ===========================================
# JWT (Autenticación)
# ===========================================
# IMPORTANTE: Cambiar en producción
JWT_SECRET=oralsuite-dev-secret-change-in-production-2024
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=oralsuite-refresh-secret-change-in-production-2024
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# URLs de Frontend
# ===========================================
DASHBOARD_URL=http://localhost:3100
LANDING_URL=http://localhost:3200

# ===========================================
# CORS
# ===========================================
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3100,http://localhost:3200

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# Archivos/Uploads
# ===========================================
# Directorio para almacenar archivos subidos (desarrollo)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===========================================
# Socket.io (Chat en tiempo real)
# ===========================================
SOCKET_PORT=3000

# ===========================================
# Logs
# ===========================================
LOG_LEVEL=debug

# ===========================================
# Producción (descomentar cuando sea necesario)
# ===========================================
# SSL_ENABLED=true
# COOKIE_SECURE=true
# TRUST_PROXY=true
